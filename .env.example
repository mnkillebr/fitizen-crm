# Postgres (used by docker compose `db`, and to build DATABASE_URL for app/ops)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

# Host / local-dev connection (pnpm run db:migrate on your machine against Docker Desktop Postgres).
# Inside Compose, app and ops override this to use hostname `db`.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/crm

# Public hostname for Caddy + TLS (no scheme). Must have a DNS A record to this host.
DOMAIN=example.com

# App — use the HTTPS origin that matches DOMAIN (no trailing slash).
AUTH_SECRET=generate-a-long-random-string
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APP_URL=https://example.com
